# No import directive, and no Imports: entry in DESCRIPTION to permit one:
# the reader is linked statically from zucsv's installed libzucsv.a, and
# its Arrow builders from zuarrow's libzuarrow.a, so neither package has to
# be loadable at run time. tools/ci/consumer.sh checks both, and runs the
# fixture with zucsv and zuarrow moved out of the library.
useDynLib(zucsvlink, .registration = TRUE)
export(abi)
export(read_stream)
export(strtod_mode)
